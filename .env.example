# Ithihasam backend configuration.
#
#   cp .env.example .env
#
# The values below are PRODUCTION-SAFE defaults. For local development set
# DEBUG=true and relax the cookie/SSL flags — do not do the reverse on a server.
# settings.py refuses to start without SECRET_KEY, ALLOWED_HOSTS, and an https
# SITE_URL when DEBUG is off, so a half-configured deploy fails loudly.

# --- Core -------------------------------------------------------------------
# Generate with:
#   python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=
DEBUG=false
ALLOWED_HOSTS=ithihasam.in,www.ithihasam.in

# --- Database ---------------------------------------------------------------
DATABASE_URL=sqlite:///db.sqlite3
DATABASE_CONN_MAX_AGE=600
DATABASE_SSL_REQUIRE=false

# --- Site -------------------------------------------------------------------
TIME_ZONE=Asia/Kolkata
# Must be https in production; used for absolute sitemap URLs.
SITE_URL=https://ithihasam.in
LOG_LEVEL=INFO

# --- CORS / CSRF ------------------------------------------------------------
# https only. The frontend posts bookings to /api/contact/ from these origins.
CORS_ALLOWED_ORIGINS=https://ithihasam.in,https://www.ithihasam.in
CSRF_TRUSTED_ORIGINS=https://ithihasam.in,https://www.ithihasam.in
CORS_ALLOW_CREDENTIALS=false
CORS_ALLOW_ALL_ORIGINS=false

# --- Abuse control ----------------------------------------------------------
# Booking submissions per IP. Tighten if you see spam.
CONTACT_SUBMISSION_THROTTLE_RATE=10/hour

# --- Transport security -----------------------------------------------------
SECURE_SSL_REDIRECT=true
SESSION_COOKIE_SECURE=true
CSRF_COOKIE_SECURE=true
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=true
# Only enable preload once you are certain every subdomain is https.
SECURE_HSTS_PRELOAD=false
# Set true only when running behind a reverse proxy that sets X-Forwarded-Host.
USE_X_FORWARDED_HOST=true
WHITENOISE_MAX_AGE=31536000
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# --- Email ------------------------------------------------------------------
# Booking notifications are sent over SMTP. Fill these in on the server only:
# never commit real credentials, and rotate any that have been shared.
#
# Gmail requires an App Password (Account > Security > 2-Step Verification >
# App passwords). The normal account password will be rejected with
# "535 Username and Password not accepted".
#
# Zoho (your MX records point at Zoho, so services@ithihasam.in is a Zoho
# mailbox) uses smtp.zoho.in with an app-specific password generated the same way.
#
# Verify after editing:   python manage.py test_email
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true
EMAIL_USE_SSL=false
EMAIL_TIMEOUT=30

# Gmail rewrites the From header to the authenticated account unless the
# address is a verified alias, so set this to the sending account itself.
DEFAULT_FROM_EMAIL=
SERVER_EMAIL=

# Who receives booking enquiries. Comma-separated; all of them get every lead.
BOOKING_NOTIFICATION_EMAILS=services@ithihasam.in,asharafsaleena22@gmail.com

# --- Analytics ----------------------------------------------------------------
# Local GeoIP City database, so visitor locations resolve instead of reading
# "Unknown". No visitor IP is sent to any third party, and none is stored.
#   wget https://download.db-ip.com/free/dbip-city-lite-2026-11.mmdb.gz
#   gunzip dbip-city-lite-2026-11.mmdb.gz
GEOIP_CITY_DB=
ANALYTICS_RETENTION_DAYS=90
